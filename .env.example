# Copy to .env.local for local development, and set the same names in
# Vercel > Project > Settings > Environment Variables for deploys.
# None of these reach the browser.

# The Google Sheet's "Publish to web" CSV link for the race tab.
# Unset: /api/races answers 503 and the page uses its bundled calendar.
RACES_CSV_URL=

# Enquiry email. Not used until a provider is wired up in lib/email.js.
ENQUIRY_TO=alex@grandprixgrandtours.com
ENQUIRY_FROM=bookings@grandprixgrandtours.com

# HubSpot form that receives each enquiry's contact details (lib/hubspot.js).
# Portal id: the number in your HubSpot URLs. Form id: the GUID in the form's
# URL. Leave both unset to skip HubSpot. Use a test form for previews.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=
# Optional private-app token with the "forms" scope (authenticated submissions).
HUBSPOT_TOKEN=
