# Copy to .env.local for local development, and set the same names in
# Vercel > Project > Settings > Environment Variables for deploys.
# None of these reach the browser.

# The Google Sheet's "Publish to web" CSV link for the race tab.
# Unset: /api/races answers 503 and the page uses its bundled calendar.
RACES_CSV_URL=

# Enquiry email, sent through Resend (lib/email.js). The API key needs
# "sending access". Unset: dev and previews print the email to the log
# instead, and production refuses enquiries. ENQUIRY_FROM must be on the
# domain verified in Resend. ENQUIRY_TO takes several addresses, comma
# separated. Give previews a test inbox, not the team's.
RESEND_API_KEY=
ENQUIRY_TO=
ENQUIRY_FROM=

# HubSpot form that receives each enquiry's contact details (lib/hubspot.js).
# Portal id: the number in your HubSpot URLs. Form id: the GUID in the form's
# URL. Leave both unset to skip HubSpot. Use a test form for previews.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=
# Private-app token with the "forms" scope. Used to read the form's hidden
# field defaults (the API doesn't apply them) and check values against it.
# Unset: submissions go without defaults, unchecked.
HUBSPOT_TOKEN=
